# Supabase project URL. Safe to expose to the browser (it's just the
# project endpoint), but nothing in this app currently reads it
# client-side — it's only used by the server-only Supabase client in
# src/lib/server/supabase-client.ts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Service role key. Server-only — bypasses Row Level Security, so it
# must NEVER be prefixed with NEXT_PUBLIC_ or imported from client
# components. Only src/lib/server/supabase-client.ts reads this.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for triggering trend collection manually
# (POST /api/admin/collect-trends) and for the Vercel Cron job
# (GET /api/cron/daily-trends). Required — both routes return 401
# without a matching "Authorization: Bearer <value>" header.
# Generate one with: openssl rand -hex 32
ADMIN_CRON_SECRET=your-admin-cron-secret

# No env var needed for GDELT — the DOC 2.0 API (src/lib/server/gdelt.ts)
# is public and requires no API key.

# Local/dev-only test override for RSS collection (src/lib/server/
# rss-sources.ts). When "true", uses the full curated feed list
# (including feeds marked permission_required in
# src/lib/server/rss-source-policy.ts) instead of the license-filtered
# default. Has NO effect when NODE_ENV=production — production always
# filters to allowed/conditional feeds only, regardless of this value.
# Leave unset or "false" to test with the same filtered list production
# uses.
RSS_DEV_INCLUDE_ALL_FEEDS=false

# OpenAI key for generating real per-trend summaries/expressions from
# the RSS metadata already collected (src/lib/server/
# generate-trend-with-llm.ts). Server-only — never prefix with
# NEXT_PUBLIC_. Optional: if unset (or the API call fails), collection
# automatically falls back to the rule-based stub generator in
# src/lib/server/generate-trend-draft.ts, so the app works without it.
OPENAI_API_KEY=your-openai-api-key

# Portfolio/demo switch (src/lib/server/trend-repository.ts). When exactly
# "true", the home feed and /trend/[id] show only the 7 hand-written
# "culture editorial" trends in src/lib/mock-data.culture-editorials.ts —
# bypassing Supabase and the original src/lib/mock-data.ts content
# entirely (no DB reads happen in this mode). Unset, empty, or any other
# value keeps the existing DB-first + mock-data.ts-fallback behavior
# completely unchanged. Does not affect RSS collection/cron — those keep
# running (and writing to Supabase) independently of this flag.
MOCK_MODE=false

# Amplitude analytics API key. Public/client-side by design (it's a
# write-only tracking key, not a secret) — read by
# src/components/amplitude-init.tsx to initialize the Browser SDK.
NEXT_PUBLIC_AMPLITUDE_API_KEY=your-amplitude-api-key

# Mixpanel project token. Public/client-side by design (same write-only
# nature as the Amplitude key above) — read by
# src/components/mixpanel-init.tsx to initialize the Browser SDK.
NEXT_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-project-token
