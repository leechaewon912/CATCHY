# Supabase project URL. Safe to expose to the browser (it's just the
# project endpoint), but nothing in this app currently reads it
# client-side — it's only used by the server-only Supabase client in
# src/lib/server/supabase-client.ts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Service role key. Server-only — bypasses Row Level Security, so it
# must NEVER be prefixed with NEXT_PUBLIC_ or imported from client
# components. Only src/lib/server/supabase-client.ts reads this.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for triggering trend collection manually
# (POST /api/admin/collect-trends) and for the Vercel Cron job
# (GET /api/cron/daily-trends). Required — both routes return 401
# without a matching "Authorization: Bearer <value>" header.
# Generate one with: openssl rand -hex 32
ADMIN_CRON_SECRET=your-admin-cron-secret

# No env var needed for GDELT — the DOC 2.0 API (src/lib/server/gdelt.ts)
# is public and requires no API key.
